# CodeInsight-AI local development configuration.
# Copy this file to .env and fill only the providers you use.
# Never commit .env or real API keys.

# Backend
PORT=8001
SERVER_BASE_URL=http://127.0.0.1:8001
PYTHON_BACKEND_HOST=http://127.0.0.1:8001
LOG_LEVEL=INFO
CODEINSIGHT_DB_PATH=

# Persistent task workers and continuous local-project scanning
DEEPWIKI_MAX_CONCURRENT_WIKI_TASKS=2
DEEPWIKI_WIKI_PAGE_CONCURRENCY=1
DEEPWIKI_WIKI_PAGE_RETRIES=2

# Default generation provider (Google)
GOOGLE_API_KEY=

# Default embedding provider (OpenAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional providers
OPENROUTER_API_KEY=
LITELLM_API_KEY=
LITELLM_BASE_URL=

# DashScope / OpenAI-compatible provider
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Local Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Embedding provider: openai, google, ollama, or bedrock
DEEPWIKI_EMBEDDER_TYPE=openai

# Optional custom configuration directory
DEEPWIKI_CONFIG_DIR=

# Optional local access protection
DEEPWIKI_AUTH_MODE=false
DEEPWIKI_AUTH_CODE=

# Browser/WebView runtime
NEXT_PUBLIC_API_PORT=8001
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8001
